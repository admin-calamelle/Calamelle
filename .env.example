# PostgreSQL (Neon/Supabase/Render/Railway/etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Set false only for a local PostgreSQL server without TLS.
PGSSL=true
# Keep this low on serverless platforms. Neon pooled URLs are recommended on Vercel.
PG_POOL_MAX=3
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000

PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret-in-production
FRONTEND_URL=http://localhost:5173
PAYMENTS_MODE=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_NATURALISATION=
STRIPE_PRICE_LIFETIME=

# Brevo SMTP — Settings > SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_MS=20000

# This sender/domain must be verified in Brevo before production use.
EMAIL_FROM=Calamelle <gftijnational@gmail.com>

# OTP rules
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5

# true = show the OTP in the local verification screen when SMTP is not configured.
# Set false in production.
EXPOSE_DEV_OTP=true

PASSWORD_RESET_MINUTES=30

# Testing only: keep the CALA-DEMO-2026 access code enabled locally.
# Set false in production.
ENABLE_DEMO_ACCESS_CODE=true
